# Copy to .env.phone.local and provide server-only values.
PHONE_BRIDGE_SECRET=
# Website with /api/phone/runtime deployed; the launcher registers its tunnel there.
PHONE_STAFF_SITE_URL=https://your-staff-site.example
# The local tunnel launcher uses port 4318. Direct server execution supports PHONE_PORT.
PHONE_ALLOWED_ORIGINS=https://your-citizen-site.example,https://your-staff-site.example
# Optional cloudflared executable path; otherwise uses outputs/phone-runtime/cloudflared.exe.
CLOUDFLARED_PATH=

# Optional model policy overrides; these are model IDs, never API keys.
PHONE_LIVE_TRANSCRIPTION_MODEL=gpt-live-transcribe
PHONE_TRANSCRIPTION_MODEL=gpt-transcribe
PHONE_NATIVE_REVIEW_MODEL=gpt-realtime-2.1
