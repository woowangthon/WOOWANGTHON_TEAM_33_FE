# Copy to .env.phone.local and provide server-only values.
PHONE_BRIDGE_SECRET=
PHONE_PROVIDER_TOKEN=
PHONE_BRIDGE_URL=
# The local tunnel launcher uses port 4318. Direct server execution supports PHONE_PORT.
PHONE_ALLOWED_ORIGINS=https://your-citizen-site.example,https://your-staff-site.example
# Optional cloudflared executable path; otherwise uses outputs/phone-runtime/cloudflared.exe.
CLOUDFLARED_PATH=
