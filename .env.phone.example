# Copy to .env.phone.local and provide server-only values.
PHONE_BRIDGE_SECRET=
# Website with /api/phone/runtime deployed; the launcher registers its tunnel there.
PHONE_STAFF_SITE_URL=https://your-staff-site.example
# Separate ports keep an existing bridge running during a provider change.
PHONE_PORT=4318
PHONE_ALLOWED_ORIGINS=https://your-citizen-site.example,https://your-staff-site.example
# Optional cloudflared executable path; otherwise uses outputs/phone-runtime/cloudflared.exe.
CLOUDFLARED_PATH=

# Optional model policy overrides; these are model IDs, never API keys.
PHONE_LIVE_TRANSCRIPTION_MODEL=gpt-live-transcribe
PHONE_TRANSCRIPTION_MODEL=gpt-transcribe
PHONE_NATIVE_REVIEW_MODEL=gpt-realtime-2.1
# Minimum time between partial safety request starts, per call (milliseconds).
# Latest transcript deltas coalesce while a request is running; no word-list gate.
PHONE_SAFETY_INTERVAL_MS=400
# Recommended phone analysis. Web complaint processing remains OpenAI.
PHONE_ANALYSIS_PROVIDER=gemini
PHONE_TEXT_PROVIDER=gemini
PHONE_GEMINI_MODEL=gemini-3.5-flash-lite
PHONE_GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
# Caller -> officer playback delay. Officer -> caller stays immediate.
PHONE_AUDIO_DELAY_MS=2500
# GEMINI_API_KEY stays in ignored .env.phone-comparison.local or the server environment.
