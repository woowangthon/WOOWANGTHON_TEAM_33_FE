DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
APP_SECRET=
STAFF_EMAILS=
SITE_MODE=citizen
STAFF_SITE_URL=
CITIZEN_SITE_URL=
# Service credentials: provision as Vercel Secrets in both projects, never NEXT_PUBLIC_.
# Explicit administrative jurisdiction, independent of the staff inbox access scope.
SERVICE_JURISDICTION=청주시
SERVICE_OPENAI_API_KEY=
SERVICE_OPENAI_MODEL=gpt-6-luna
SERVICE_LAW_API_OC=
# HTTPS service origin registered with the law API (server-only, no path or credentials).
SERVICE_LAW_ORIGIN=
# Legacy account-only defaults, not inherited by guest workspaces.
OPENAI_API_KEY=
LAW_API_OC=

# Public hackathon staff inbox; contains synthetic data only.
PUBLIC_STAFF_INBOX=false
# Both website projects and the phone bridge must use the same secret.
PHONE_BRIDGE_SECRET=
PHONE_BRIDGE_URL=
# Optional exact hostnames for signed runtime registration (trycloudflare.com tunnels are supported by default).
PHONE_BRIDGE_HOSTS=

# Optional deployment helper settings (your own Vercel projects).
VERCEL_SCOPE=
VERCEL_ORG_ID=
VERCEL_CITIZEN_PROJECT_ID=
VERCEL_STAFF_PROJECT_ID=
VERCEL_CLI_PATH=
